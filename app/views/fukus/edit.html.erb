<h1>服の編集</h1>

<% if @fuku.errors.any? %>
  <div class="error-panel" role="alert">
    <strong>入力内容を確認してください</strong>
    <ul>
      <% @fuku.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @fuku, local: true, class: "form-card" do |form| %>
  <div class="field">
    <%= form.label :name, "名前" %><br>
    <%= form.text_field :name %>
  </div>
  <div class="field">
    <%= form.label :price, "価格" %><br>
    <%= form.number_field :price %>
  </div>
  <div class="field">
    <%= form.label :url, "URL" %><br>
    <%= form.text_field :url %>
  </div>
  <%= form.submit "更新" %>
<% end %>

<%= link_to '一覧に戻る', fukus_path, class: "back-link" %>